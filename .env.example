# ── Core ─────────────────────────────────────────────────────────────────────
# Server port (default 5000)
PORT=5000

# Public site URL (no trailing slash) — required on any deployed host for Stripe return URLs & webhooks.
# PUBLIC_APP_URL=https://www.yourdomain.com

# PostgreSQL — required for wallet/chat/video persistence, Stripe sync tables, drizzle.
# Local (docker compose): postgresql://equilibrium:equilibrium@localhost:5432/equilibrium
# Supabase: Settings → Database → URI (pooler 6543 if 5432 blocked)
# Omit to boot with in-memory fallbacks; /health shows database.configured=false
DATABASE_URL=postgresql://equilibrium:equilibrium@localhost:5432/equilibrium

# ── Stripe (subscriptions / checkout) ─────────────────────────────────────
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...

# ── OpenAI (optional — AI chat, pattern AI, image routes degrade without keys) ─
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=
# OPENAI_API_KEY=

# ── Hyperliquid server tuning ─────────────────────────────────────────────────
# Set to 1 to disable server-side candle cache (more API load, always fresh bars)
# HL_DISABLE_CANDLE_CACHE=

# ── Client (Vite — prefix VITE_) rebuild after changing ───────────────────────
# Wallet gate: off automatically in `npm run dev`. For deployed preview without a wallet, set before build:
# VITE_WALLET_GATE_DISABLED=true
# To test the gate while in dev: VITE_WALLET_GATE_DISABLED=false
# Stripe Payment Links (defaults match production links in client/src/lib/stripe-payment-links.ts)
# VITE_STRIPE_PAYMENT_LINK_PRO=https://buy.stripe.com/...
# VITE_STRIPE_PAYMENT_LINK_MENTORING=https://buy.stripe.com/...
# Hyperliquid — baked into the client at build time; use .env.production (see .env.production.example)
# VITE_BUILDER_ADDRESS=0x...   # registered builder wallet; required for builder fees on orders
# VITE_HL_REFERRAL_CODE=BANKS  # your HL referral code

# ── Object storage (legacy Replit sidecar only — leave unset on Railway/Render/VPS) ─
# USE_REPLIT_OBJECT_STORAGE=1
# PUBLIC_OBJECT_SEARCH_PATHS=
# PRIVATE_OBJECT_DIR=
