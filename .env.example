# ── Core ─────────────────────────────────────────────────────────────────────
# Server port (default 5000)
PORT=5000

# Public site URL (no trailing slash) — required on any deployed host for Stripe return URLs & webhooks.
# PUBLIC_APP_URL=https://www.yourdomain.com

# PostgreSQL — required for wallet/chat/video persistence, Stripe sync tables, drizzle.
# Local (docker compose): postgresql://equilibrium:equilibrium@localhost:5432/equilibrium
# Supabase: Settings → Database → URI (pooler 6543 if 5432 blocked)
# Omit to boot with in-memory fallbacks; /health shows database.configured=false
DATABASE_URL=postgresql://equilibrium:equilibrium@localhost:5432/equilibrium

# MongoDB — optional; Command Center videos (`tutorial_videos`, legacy `videos` merged on read), CRM `users`, support tickets.
# MONGO_VIDEOS_COLLECTION=tutorial_videos
# Must start with mongodb:// or mongodb+srv:// (never put a Mongo URI in DATABASE_URL).
# MONGO_VAULT_URI=mongodb+srv://user:pass@cluster.mongodb.net/
# MONGODB_DB_NAME=equilibrium

# Extra admin wallets (comma-separated, 0x…). Same privileges as built-in admins: /admin, videos CRUD, leads, support.
# ADMIN_WALLET_ADDRESSES=0xYourWalletHere

# Optional second “master bypass” wallet (full 0x + 40 hex) — always Pro in UI + /api/user/sync, no session.
# Use for the 0x2cbf…be6b principal; must set both in production if the UI is a separate Vite build:
# MASTER_BYPASS_WALLET_2=0x...
# VITE_MASTER_BYPASS_WALLET_2=0x...

# Admin Equilibrium CRM (/admin-equilibrium): master wallet for Command Center APIs + UI guard.
# ADMIN_EQUILIBRIUM_MASTER_WALLET=0xYourMasterWalletHere

# Optional: Vite build-time double-check (must match the wallet you connect in the browser).
# VITE_ADMIN_MASTER_WALLET=0xYourMasterWalletHere

# Telegram — alert on each user support message from the trading UI (server → your phone).
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=your_numeric_chat_id

# ── Stripe (subscriptions / checkout) ─────────────────────────────────────
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...
# Server-only: payment automation → POST /api/billing/sync-tier with header x-equilibrium-billing-secret
# EQUILIBRIUM_BILLING_SYNC_SECRET=long-random-string

# ── OpenAI (optional — AI chat, pattern AI, image routes degrade without keys) ─
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=
# OPENAI_API_KEY=

# ── Hyperliquid server tuning ─────────────────────────────────────────────────
# Set to 1 to disable server-side candle cache (more API load, always fresh bars)
# HL_DISABLE_CANDLE_CACHE=

# Circle CCTP — Arbitrum USDC → HyperEVM → HyperCore (Portfolio deposit). **No bridge addresses in the client.**
# Obtain current contract addresses from Circle / Hyperliquid CCTP documentation (mainnet vs testnet).
# @see https://developers.circle.com/cctp/howtos/transfer-usdc-from-arbitrum-to-hypercore
# CCTP_EXTENSION_ADDRESS=0x...
# CCTP_USDC_ADDRESS=0x...
# CCTP_FORWARDER_ADDRESS=0x...   # HyperEVM CctpForwarder — mintRecipient AND destinationCaller per Circle
# CCTP_IRIS_API_BASE=https://iris-api.circle.com
# CCTP_SOURCE_DOMAIN=3           # Arbitrum (verify in Circle domain table)
# CCTP_DESTINATION_DOMAIN=19     # HyperEVM (verify for your network)
# CCTP_ARBITRUM_CHAIN_ID=42161
# CCTP_MIN_DEPOSIT_USDC=5
# CCTP_MIN_FINALITY_THRESHOLD=1000
# CCTP_USDC_EIP712_NAME=USD Coin
# CCTP_USDC_EIP712_VERSION=2
# Optional if Iris is down: forward fee in USDC 6-decimal subunits (e.g. 200000 = 0.20 USDC)
# CCTP_FORWARD_FEE_STATIC=200000

# ── Observability (optional) ─────────────────────────────────────────────────
# Server: create a Node project in Sentry, copy DSN (secret — Railway only, not Vite).
# SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
#
# Browser: same Sentry project → Client Keys → browser DSN. Rebuild client after setting.
# VITE_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
# VITE_SENTRY_TRACES_SAMPLE_RATE=0

# ── Client (Vite — prefix VITE_) rebuild after changing ───────────────────────
# Wallet gate: off automatically in `npm run dev`. For deployed preview without a wallet, set before build:
# VITE_WALLET_GATE_DISABLED=true
# To test the gate while in dev: VITE_WALLET_GATE_DISABLED=false
# Stripe Payment Links (defaults match production links in client/src/lib/stripe-payment-links.ts)
# VITE_STRIPE_PAYMENT_LINK_PRO=https://buy.stripe.com/...
# VITE_STRIPE_PAYMENT_LINK_MENTORING=https://buy.stripe.com/...
# Hyperliquid — baked into the client at build time; use .env.production (see .env.production.example)
# VITE_BUILDER_ADDRESS=0x...   # registered builder wallet; required for builder fees on orders
# VITE_HL_REFERRAL_CODE=BANKS  # your HL referral code

# ── Video uploads: stored on server disk at uploads/videos (gitignored). No env required. ─
# Not Replit-specific: on ANY host with multiple instances, use one replica or a mounted volume
# for uploads/ — or use only YouTube/Vimeo URLs in Command Center → Videos. See HOSTING.md.
