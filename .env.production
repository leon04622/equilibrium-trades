# Copy to `.env.production` in the project root before `npm run build` or Docker build.
# Vite reads this file automatically during production builds (values are baked into the JS bundle).

# Hyperliquid — defaults to production builder in code; override here if needed
VITE_BUILDER_ADDRESS=0x... # Your registered builder wallet address
VITE_HL_REFERRAL_CODE=BANKS # Your Hyperliquid referral code

# Optional — override Stripe Payment Links (get from Stripe Dashboard → Payment Links)
# VITE_STRIPE_PAYMENT_LINK_PRO=https://buy.stripe.com/...
# VITE_STRIPE_PAYMENT_LINK_MENTORING=https://buy.stripe.com/...