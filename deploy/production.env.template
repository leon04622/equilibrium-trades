# Copy to `.env` next to docker-compose.prod.yml, or paste into Railway / Render env UI.
# Never commit real secrets.

# --- Required for production ---
PUBLIC_APP_URL=https://www.yourdomain.com
DATABASE_URL=postgresql://user:password@host:5432/dbname
# MongoDB CRM / journal / support persistence (required if you want saved journal entries and CRM data to survive restarts)
MONGO_VAULT_URI=mongodb+srv://user:password@cluster.mongodb.net/
# MONGODB_DB_NAME=equilibrium

# --- Stripe (subscriptions + webhooks) ---
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...

# --- Docker Compose only (if using docker-compose.prod.yml) ---
POSTGRES_PASSWORD=generate-a-strong-password
MONGO_ROOT_PASSWORD=generate-a-strong-password
APP_PORT=5000

# --- Docker build args / .env.production for Vite (Hyperliquid client) ---
VITE_BUILDER_ADDRESS=0xYourRegisteredBuilderWallet
VITE_HL_REFERRAL_CODE=YOURCODE

# --- Observability (optional) ---
# SENTRY_DSN=https://...@....ingest.sentry.io/...   # server errors (Railway env only)
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Rebuild client after setting browser DSN:
# VITE_SENTRY_DSN=https://...@....ingest.sentry.io/...
# VITE_SENTRY_TRACES_SAMPLE_RATE=0

# --- Optional ---
# ADMIN_WALLET_ADDRESSES=0xabc...,0xdef...   # admin panel + video management (in addition to built-in list in code)
# VITE_STRIPE_PAYMENT_LINK_PRO=https://buy.stripe.com/...
# VITE_STRIPE_PAYMENT_LINK_MENTORING=https://buy.stripe.com/...
# OPENAI_API_KEY=
# PORT=5000
# VITE_WALLET_GATE_DISABLED=true   # preview only — omit for real launch
